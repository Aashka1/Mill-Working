# Copy to backend/.env for local development. Never commit the real file.

# MongoDB Atlas SRV string, or mongodb://localhost:27017 for a local server.
MONGO_URL=mongodb://localhost:27017
DB_NAME=agrimill

# Signing key for auth tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Seeded on first startup. Change these before deploying anywhere public.
ADMIN_EMAIL=admin@agrimill.com
ADMIN_PASSWORD=admin123

# Only used for CORS when the frontend runs separately (local `yarn start`).
# Irrelevant in the Docker deploy, where FastAPI serves the build itself.
FRONTEND_URL=http://localhost:3000

# ---- Password reset email (optional) ----
# Leave unset and the reset flow still works: the link is written to the
# service logs instead of emailed, for the operator to pass on. Set all three
# of SMTP_HOST / SMTP_USER / SMTP_PASS to switch on real delivery.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=AgriMill <you@gmail.com>

# Origin used to build reset links. Defaults to the incoming request's host,
# which is correct on Render; set only if you put a custom domain in front.
# PUBLIC_URL=https://agrimill.onrender.com
